@{
    ViewData["Title"] = "Edit Card";
}

@model Card

<h2>Edit Card</h2>


<form class="navbar-form navbar-left" asp-action="SaveCard" asp-controller="Admin" method="get">
    <input asp-for="Id" type="hidden"/>
    <div class="row">
        <div class="col-3">
            <label for="Name">Name</label>
            <input asp-for="Name" type="text" id="Name" name="Name" class="form-control" placeholder="Model.Name">
        </div>
        <div class="col-3">
            <label for="Set">Set</label>
            <select id="Set" name="SetId" asp-for="SetId" asp-items="@(new SelectList(ViewBag.Sets,"Id","FullName",ViewBag.Set))" class="form-select"></select>
        </div>
        <div class="col-2">
            <label for="Number">Number</label>
            <input asp-for="Number" type="text" id="Number" name="Number" class="form-control" placeholder="Model.Number">
        </div>
        <div class="col-2">
            <label for="Rarity">Rarity</label>
            <input asp-for="Rarity" type="text" id="Rarity" name="Rarity" class="form-control" placeholder="Model.Rarity">
        </div>
        <div class="col-2">
            <label for="Edition">Edition</label>
            <input asp-for="Edition" type="text" id="Edition" name="Edition" class="form-control" placeholder="Model.Edition">
        </div>
    </div>
    <br />
    <div class="buttons">
        <input type="submit" formmethod="post" value="Save Card" class="btn btn-primary" />
    </div>
</form>
